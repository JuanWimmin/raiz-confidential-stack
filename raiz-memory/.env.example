# Soroban RPC endpoint (testnet)
RPC_URL=https://soroban-testnet.stellar.org
# Comma-separated contract ids to index: CT wrapper, goal_meta, SPP pool...
CONTRACT_IDS=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABASE_URL=sqlite://raiz_memory.db?mode=rwc
POLL_INTERVAL_SECS=5
PORT=8090
# Purge demo mode (optional, demo prop — see README "Purge demo mode"):
# requests with &source=rpc-simulation only see the last N ledgers.
# RETENTION_SIMULATION_LEDGERS=120
