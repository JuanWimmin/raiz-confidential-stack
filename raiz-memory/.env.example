# Soroban RPC endpoint (testnet)
RPC_URL=https://soroban-testnet.stellar.org

# Comma-separated contract ids to index.
# The defaults below index the real Sobre del Barrio history plus the two public
# contracts that demonstrate what an RPC has already forgotten:
#   1. CBWSANZN... our CT wrapper (Confidential Tokens, deployed at ledger 3950128)
#   2. CBNVY2AA... our goal_meta contract        (deployed at about ledger 3950200)
#   3. CBF64DEO... the official CT demo wrapper  (deployed at ledger 3013364)
#   4. CCUUDM43... the Nethermind SPP EURC pool  (indexing it is one line of config)
CONTRACT_IDS=CBWSANZN7YIMA4CWLNSAZO3HSD5NZDC2GZQJ434MOPQR7RDNVYQSDHAT,CBNVY2AAHA4SP3MX4XKJAZGS63SF4GIFNHUAAQPRSKYAXY3XR6HKIQAZ,CBF64DEOVQAXJFBSNGFEUT2AH4H7K5JBY3ZYJ5GVEINMNSDISWRG5N3F,CCUUDM434BMZMYWYDITHFXHDMIVTGGD6T2I5UKNX5BSLXLW7HVR4MCGZ

# --- Historical backfill (see README "Backfill: where history begins") -------
# How far back the FIRST run of a contract reaches. Applied only to a contract
# with no cursor yet, so it can never rewind a tail that is already live.
#
#   oldest    as far back as this RPC still holds (its retention floor)
#   head      only what happens from now on (the pre-backfill behavior)
#   <ledger>  an explicit ledger, e.g. the contract's deployment ledger.
#             If the RPC no longer holds it we clamp to its floor, log how many
#             ledgers were unreachable, and /coverage reports it permanently.
#
# Default for any contract without an entry in CONTRACT_START_LEDGERS:
BACKFILL_FROM_LEDGER=oldest

# Per-contract overrides: CONTRACTID:LEDGER pairs, comma-separated.
# Every id here must also appear in CONTRACT_IDS or startup fails — a typo that
# silently indexes nothing is the exact bug this setting exists to prevent.
#
# Our two contracts start at their deployment ledgers: the complete history,
# with no pointless scanning of the ledgers before they existed. The official CT
# demo wrapper asks for ITS deployment ledger (3013364), which is far below any
# current retention floor: that entry is the clamp demo, and /coverage will
# report roughly 800k ledgers as already unreachable.
CONTRACT_START_LEDGERS=CBWSANZN7YIMA4CWLNSAZO3HSD5NZDC2GZQJ434MOPQR7RDNVYQSDHAT:3950128,CBNVY2AAHA4SP3MX4XKJAZGS63SF4GIFNHUAAQPRSKYAXY3XR6HKIQAZ:3950200,CBF64DEOVQAXJFBSNGFEUT2AH4H7K5JBY3ZYJ5GVEINMNSDISWRG5N3F:3013364

DATABASE_URL=sqlite://raiz_memory.db?mode=rwc
POLL_INTERVAL_SECS=5
PORT=8090

# Purge demo mode (optional, demo prop — see README "Purge demo mode"):
# requests with &source=rpc-simulation only see the last N ledgers.
# RETENTION_SIMULATION_LEDGERS=120
