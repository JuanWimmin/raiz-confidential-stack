<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The harness only talks to the CT demo dev server (localhost via adb
         reverse, or the PC's LAN IP) and, through the demo page, to the
         Soroban testnet RPC. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- networkSecurityConfig replaces the earlier usesCleartextTraffic attr:
         it keeps cleartext allowed (localhost spike fallback) AND adds the
         Sectigo R46 root missing from this device family's system store —
         without it every Kotlin HTTPS call to *.stellar.org dies with
         "Trust anchor for certification path not found" (friction-report
         2026-08-03; the WebView is unaffected because Chromium AIA-chases). -->
    <application
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- configChanges: keep the WebView alive across rotation — an
             accidental rotate must not reload the page mid-proof (proofs can
             take up to the 90 s GO threshold). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
